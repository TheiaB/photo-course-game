; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Waiting for Gonad"
config/description="Mit Waiting for Gonad untersucht Theia Bähr auf eine künstlerische Art ihre Beziehung zu den Warteräumen, die ihren Weg als trans Frau so oft zum Stillstand gebracht haben.

Im Laufe des Projekts besucht, erlebt und fotografiert sie diese Warteräume wieder: Zwischen Hausarzt, Psychiater, Therapieambulanz, Gynäkologie, Endokrinologie und diversen Kliniken wird sie wieder und wieder widersprüchlich informiert, ihr die körperliche Selbstbestimmung abgesprochen, hingehalten und Medikamente verweigert. Heute ist sie eine radikale Befürworterin von DIY HRT (\"Do-it-yourself Hormone Replacement Therapy\").

Verzerrt in die 3. Dimension laden diese fotografischen Dioramen dazu ein, die Perspektive auf jene Räume interaktiv zu verändern.

Das Projekt ist nicht abgeschlossen und wird, solange sie Warteräume für Ihre Transition besuchen muss, stetig fortgeführt.
"
config/version="1.0"
run/main_scene="res://scenes/matrjoschka.tscn"
config/features=PackedStringArray("4.3")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="res://ui/splashy.png"
config/icon="res://ui/icon.png"

[autoload]

Global="*res://scripts/global.gd"
InputManager="*res://GTIM/InputManager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/stretch/aspect="expand"

[filesystem]

import/blender/enabled=false

[gui]

common/drop_mouse_on_gui_input_disabled=true

